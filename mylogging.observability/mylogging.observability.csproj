<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net461;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>MyLogging.Observability</Title>
    <Description>Cross-platform logging and observability library supporting .NET 8+ and .NET Framework 4.8+</Description>
    <Authors>Your Name</Authors>
    <Company>Your Company</Company>
    <Product>MyLogging.Observability</Product>
    <PackageId>MyLogging.Observability</PackageId>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Common dependencies for all target frameworks -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  
  <!-- .NET Framework specific dependencies -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
    <Reference Include="System.Web" />
    <Reference Include="System.ServiceModel"/>
    <Reference Include="System.ServiceModel.Activation"/>
    <Reference Include="System.Configuration"/>
    <Reference Include="System.ServiceModel.Web"/>
  </ItemGroup>

  <!-- .NET 8+ specific dependencies (already included in framework) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Microsoft.Extensions.Logging.Abstractions is part of .NET 8 -->
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Common\" />
    <Folder Include="Core\" />
  </ItemGroup>

  <!-- Conditional compilation symbols -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <DefineConstants>$(DefineConstants);NETCORE</DefineConstants>
  </PropertyGroup>

</Project>
