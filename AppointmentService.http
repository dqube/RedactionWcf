    "UserId": "nested-user@example.com"
  },
  "Title": "Nested Header Test",
  "Description": "Testing correlation IDs in nested header object",
  "AppointmentDate": "2024-12-21T11:00:00",
  "Location": "Room 501",
  "PatientName": "Header Test Patient",
  "DoctorName": "Dr. Header",
  "DurationMinutes": 30
}

###

