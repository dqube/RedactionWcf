  "headers": {
    "correlationId": "nested-headers-001",
    "consumerId": "nested-headers-app",
    "userId": "headers-user@example.com"
  },
  "Title": "Nested Headers Test",
  "Description": "Testing correlation IDs in nested headers object (camelCase)",
  "AppointmentDate": "2024-12-21T14:00:00",
  "Location": "Room 502",
  "PatientName": "Headers Test Patient",
  "DoctorName": "Dr. Headers",
  "DurationMinutes": 45
}

