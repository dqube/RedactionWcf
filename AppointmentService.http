### 20. XML Request - HTTP Headers Override Body
POST {{serviceUrl}}/appointments
X-Correlation-Id: http-header-wins-xml-001
X-Consumer-Id: http-header-consumer
X-User-Id: http-header-user@example.com
Content-Type: application/xml
Accept: application/xml

<?xml version="1.0" encoding="utf-8"?>
<Appointment xmlns="http://schemas.datacontract.org/2004/07/RedactionWcf.Models">
  <AppointmentDate>2024-12-25T11:00:00</AppointmentDate>
  <CorrelationId>xml-body-ignored</CorrelationId>
  <ConsumerId>xml-body-consumer-ignored</ConsumerId>
  <Description>HTTP headers take priority over XML body</Description>
  <DoctorName>Dr. Priority</DoctorName>
  <DurationMinutes>30</DurationMinutes>
  <Location>Room 605</Location>
  <PatientName>Priority Test Patient</PatientName>
  <Title>XML Priority Test</Title>
  <UserId>xml-body-user-ignored</UserId>
</Appointment>

###

