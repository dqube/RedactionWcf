{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "Observability": {
    "ServiceName": "RedactionCoreAPI",
    "ApplicationName": "RedactionCore",
    "BusinessProcess": "Healthcare",
    "ServiceVersion": "1.0.0",
    "ServiceNamespace": "Healthcare.API",
    "ServiceInstanceId": "instance-001",
    
    "EnableRequestResponseLogging": true,
    "EnableRedaction": true,
    "LogLevel": "Information",
    "ExportBatchSize": 100,
    "ExportTimeout": "00:00:30",
    
    "Exporter": {
      "EnableConsole": true,
      "EnableOtlp": false,
      "OtlpEndpoint": "http://localhost:4317"
    },
    
    "SplunkExporter": {
      "Url": "http://localhost:8088/services/collector",
      "Token": "your-splunk-hec-token-here",
      "Source": "RedactionCoreAPI",
      "Sourcetype": "_json",
      "Index": "main",
      "EnableBatchMode": true,
      "BatchSize": 100,
      "BatchInterval": "00:00:05"
    },
    
    "Redaction": {
      "RedactionText": "[REDACTED]",
      "RedactRequestBody": true,
      "RedactResponseBody": true,
      "RedactHeaders": true,
      "RedactQueryParams": true,
      "SensitiveKeys": [
        "password",
        "pwd",
        "secret",
        "token",
        "apikey",
        "api_key",
        "authorization",
        "bearer",
        "access_token",
        "refresh_token",
        "ssn",
        "social_security",
        "creditcard",
        "credit_card",
        "cvv",
        "cvc",
        "email",
        "phone",
        "phonenumber",
        "address",
        "privatekey",
        "private_key",
        "name",
        "connectionstring"
      ]
    },
    
    "RequestResponseLogging": {
      "LogRequestBody": true,
      "LogResponseBody": true,
      "LogHeaders": true,
      "LogQueryString": true,
      "MaxBodySize": 10485760,
      "ExcludedPaths": [
        "/health",
        "/metrics",
        "/swagger"
      ],
      "CorrelationIdHeaders": [
        "X-Correlation-Id",
        "CorrelationId",
        "x-correlation-id",
        "correlationId"
      ],
      "ConsumerIdHeaders": [
        "X-Consumer-Id",
        "ConsumerId",
        "x-consumer-id",
        "consumerId"
      ],
      "UserIdHeaders": [
        "X-User-Id",
        "UserId",
        "x-user-id",
        "userId"
      ]
    },
    
    "Tracing": {
      "EnableTracing": true,
      "RecordException": true,
      "EnableHttpClientInstrumentation": true,
      "EnableAspNetCoreInstrumentation": true,
      "ActivitySources": [
        "RedactionCoreAPI",
        "Microsoft.AspNetCore"
      ]
    },
    
    "Metrics": {
      "EnableMetrics": true,
      "EnableHttpServerMetrics": true,
      "EnableHttpClientMetrics": true,
      "EnableRuntimeMetrics": true,
      "EnableCustomMetrics": true
    },
    
    "ServiceAttributes": {
      "environment": "development",
      "region": "us-east-1",
      "version": "1.0.0",
      "deployment": "local"
    }
  }
}
